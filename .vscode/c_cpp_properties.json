{
    "configurations": [
        {
            "name": "sp_vision",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "forcedInclude": [
                "${workspaceFolder}/.vscode/eigen_fix.h"
            ],
            "includePath": [
                "${workspaceFolder}/cpp/**",
                "${workspaceFolder}/cpp/io/serial/include",
                "/usr/include/opencv4",
                "/usr/include/eigen3",
                "/opt/intel/openvino_2023.3.0/runtime/include/",
                "${workspaceFolder}/python/.venv/lib/python3.12/site-packages/pybind11/include",
                "/opt/ros/humble/include/**"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
